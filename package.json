{
  "name": "@sedaia-designs/web-platform",
  "version": "1.0.0",
  "description": "Sedaia Designs web platform monorepo",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.18.0 <23",
    "pnpm": ">=10.22.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:business": "pnpm --filter @sedaia-designs/business-site dev",
    "dev:portfolio": "pnpm --filter @sedaia-designs/portfolio dev",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  }
}
